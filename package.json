{
  "name": "@redhat-developer/vscode-redhat-telemetry",
  "version": "0.10.2",
  "description": "Provides Telemetry APIs for Red Hat applications",
  "main": "lib/index.js",
  "types": "lib",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "copy-files": "node -e \"const fs=require('node:fs');fs.cpSync('src/config','lib/config',{recursive:true});fs.cpSync('src/tests/config','lib/tests/config',{recursive:true})\"",
    "compile": "esbuild src/index.ts 'src/common/**/*.ts' 'src/node/**/*.ts' 'src/webworker/*.ts' --outdir=lib --outbase=src --format=cjs --sourcemap --platform=node && tsc -b --emitDeclarationOnly",
    "typecheck": "tsc -b --noEmit",
    "build": "npm run clean && npm run copy-files && npm run compile",
    "prepublish": "npm run build",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "lint": "biome check .",
    "package": "npm run build && esbuild test-bundle/node/index.ts --bundle --platform=node --outfile=dist/node/foo.node.bundle.js --external:vscode && esbuild test-bundle/webworker/index.ts --bundle --platform=browser --outfile=dist/webworker/foo.webworker.bundle.js --external:vscode --external:node:*",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "files": [
    "/lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redhat-developer/vscode-redhat-telemetry.git"
  },
  "bugs": {
    "url": "https://github.com/redhat-developer/vscode-redhat-telemetry/issues"
  },
  "author": "Red Hat",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/getos": "^3.0.1",
    "@types/node": "^26.1.2",
    "@types/object-hash": "^3.0.2",
    "@types/picomatch": "^4.0.0",
    "@types/ua-parser-js": "^0.7.36",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "1.75.1",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@segment/analytics-node": "2.3.0",
    "countries-and-timezones": "^3.4.1",
    "getos": "^3.2.1",
    "object-hash": "^3.0.0",
    "os-locale": "^5.0.0",
    "picomatch": "^4.0.2",
    "ua-parser-js": "2.0.10",
    "uuid": "^14.0.1"
  }
}
